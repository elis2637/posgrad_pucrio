{
  "datasets": [
    {
      "name": "top_cursos_conversao",
      "displayName": "Top 10 Cursos - Taxa Conversão Pós",
      "queryLines": [
        "SELECT\n",
        "  nome_curso,\n",
        "  area_conhecimento,\n",
        "  total_egressos,\n",
        "  taxa_potencial_pos_pct,\n",
        "  media_nps\n",
        "FROM\n",
        "  mvp_eng_dados.gold.kpi_potencial_pos_graduacao\n",
        "WHERE\n",
        "  taxa_potencial_pos_pct IS NOT NULL\n",
        "ORDER BY\n",
        "  taxa_potencial_pos_pct DESC\n",
        "LIMIT 10"
      ],
      "catalog": "mvp_eng_dados",
      "schema": "default"
    },
    {
      "name": "kpi_cards",
      "displayName": "KPI Cards - Métricas Gerais",
      "queryLines": [
        "SELECT\n",
        "  COUNT(DISTINCT id_egresso) as total_egressos,\n",
        "  ROUND(\n",
        "    AVG(\n",
        "      CASE\n",
        "        WHEN potencial_matricula_pos = 1 THEN 100.0\n",
        "        ELSE 0.0\n",
        "      END\n",
        "    ),\n",
        "    2\n",
        "  ) as taxa_conversao_pos_pct,\n",
        "  ROUND(AVG(satisfacao_graduacao_nps), 2) as nps_medio,\n",
        "  ROUND(AVG(renda_mensal_estimada), 2) as renda_media\n",
        "FROM\n",
        "  mvp_eng_dados.gold.fato_egressos"
      ]
    },
    {
      "name": "egressos_por_uf",
      "displayName": "Egressos por UF",
      "queryLines": [
        "SELECT\n",
        "  uf_residencia,\n",
        "  SUM(qtd_egressos) as total_egressos,\n",
        "  ROUND(AVG(renda_media), 2) as renda_media\n",
        "FROM\n",
        "  mvp_eng_dados.gold.kpi_perfil_profissional_uf\n",
        "GROUP BY\n",
        "  uf_residencia\n",
        "ORDER BY\n",
        "  total_egressos DESC"
      ]
    },
    {
      "name": "distribuicao_nps",
      "displayName": "Distribuição NPS",
      "queryLines": [
        "SELECT\n",
        "  categoria_nps,\n",
        "  COUNT(DISTINCT id_egresso) as total_egressos\n",
        "FROM\n",
        "  mvp_eng_dados.gold.fato_egressos\n",
        "GROUP BY\n",
        "  categoria_nps\n",
        "ORDER BY\n",
        "  CASE categoria_nps\n",
        "    WHEN 'Promotor' THEN 1\n",
        "    WHEN 'Neutro' THEN 2\n",
        "    WHEN 'Detrator' THEN 3\n",
        "  END"
      ]
    },
    {
      "name": "conversao_tempo_bolsa",
      "displayName": "Conversão por Tempo e Bolsista",
      "queryLines": [
        "SELECT\n",
        "  faixa_meses_formacao,\n",
        "  CASE\n",
        "    WHEN bolsista_graduacao = 1 THEN 'Bolsista'\n",
        "    WHEN bolsista_graduacao = 0 THEN 'Não-Bolsista'\n",
        "    ELSE 'Não Informado'\n",
        "  END as status_bolsista,\n",
        "  total_egressos,\n",
        "  taxa_potencial_pos_pct\n",
        "FROM\n",
        "  mvp_eng_dados.gold.kpi_conversao_tempo_bolsa\n",
        "ORDER BY\n",
        "  CASE faixa_meses_formacao\n",
        "    WHEN '0-12m' THEN 1\n",
        "    WHEN '13-24m' THEN 2\n",
        "    WHEN '25-36m' THEN 3\n",
        "    WHEN '37-60m' THEN 4\n",
        "    WHEN '>60m' THEN 5\n",
        "  END,\n",
        "  bolsista_graduacao DESC"
      ]
    },
    {
      "name": "perfil_profissional_uf",
      "displayName": "Perfil Profissional por UF",
      "queryLines": [
        "SELECT\n",
        "  uf_residencia,\n",
        "  area_atuacao,\n",
        "  nivel_cargo,\n",
        "  tipo_empresa,\n",
        "  qtd_egressos,\n",
        "  renda_media,\n",
        "  taxa_potencial_pos_pct,\n",
        "  media_meses_formado\n",
        "FROM\n",
        "  mvp_eng_dados.gold.kpi_perfil_profissional_uf\n",
        "ORDER BY\n",
        "  qtd_egressos DESC"
      ]
    },
    {
      "name": "top_roi_cursos",
      "displayName": "Top 10 Cursos - ROI",
      "queryLines": [
        "SELECT\n",
        "  nome_curso,\n",
        "  nivel_cargo,\n",
        "  tipo_empresa,\n",
        "  renda_media,\n",
        "  mensalidade_base,\n",
        "  razao_roi_renda_mensalidade as roi\n",
        "FROM\n",
        "  mvp_eng_dados.gold.kpi_empregabilidade_roi_curso\n",
        "WHERE\n",
        "  tipo_empresa != 'DESEMPREGADO'\n",
        "  AND razao_roi_renda_mensalidade IS NOT NULL\n",
        "ORDER BY\n",
        "  razao_roi_renda_mensalidade DESC\n",
        "LIMIT 10"
      ]
    }
  ],
